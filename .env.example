# Set these variables in the process environment; this file is not auto-loaded.
# AI is optional. Without all three values, explanations use deterministic evidence.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# Development runner only; production uses Waitress --host / --port options.
# HOST=127.0.0.1
# PORT=5000
# Default paths are rooted at the repository. Explicit relative paths use the working directory.
# DATASET_PATH=data/hackathon_dataset.csv
# DATABASE_PATH=instance/catalog.sqlite3
# Local operator CLI only; independent from authenticated browser administration.
# CATALOG_ADMIN_ENABLED=1
# CATALOG_STAGING_PATH=instance/catalog-staged.sqlite3
# Browser administration: prefer scripts/configure_admin.py for local setup.
# CATALOG_WEB_ADMIN_ENABLED=1
# CATALOG_ADMIN_PASSWORD_HASH=<Werkzeug password hash>
# FLASK_SECRET_KEY=<random secret of at least 32 characters>
# CATALOG_ACTIVE_PATH=instance/catalog-active.csv
# DATASET_PATH, DATABASE_PATH, CATALOG_ACTIVE_PATH and CATALOG_STAGING_PATH must be distinct.
# Set to 1 behind HTTPS in production.
# SESSION_COOKIE_SECURE=1
